# URL pública del sitio (canonical, Open Graph, robots.txt y sitemap.xml), con
# protocolo: https://dominio. Vacía, cae así (src/constants/siteUrl.ts):
#   - En Vercel, a https://$VERCEL_PROJECT_PRODUCTION_URL (Vercel la define sola).
#   - Fuera de Vercel, a http://localhost:3000: alcanza para desarrollo, pero
#     en un deploy de producción fuera de Vercel es obligatoria.
# Un deploy de producción de Vercel que termine en localhost falla en el build.
NEXT_PUBLIC_APP_URL=

# Intensidad de las animaciones: suave | equilibrado | exagerado | apagado
# Es la misma perilla "Animaciones" del diseño en Claude Design. Por defecto: exagerado.
NEXT_PUBLIC_MOTION_LEVEL=exagerado

# ── Panel de administración (/admin) ─────────────────────────────────────────
# Guía completa: docs/panel-admin.md

# Base de datos Postgres (Neon). La crea Vercel al conectar Storage → Neon.
# Vacía en la compu: el contenido se guarda en .data/content.json (modo local).
DATABASE_URL=

# Vercel Blob, para las fotos que se suben desde el panel. La crea Vercel al
# conectar Storage → Blob. Vacía en la compu: las fotos van a public/uploads/.
BLOB_READ_WRITE_TOKEN=

# El único mail que puede entrar al panel.
ADMIN_EMAIL=

# Hash de la contraseña y secreto de las sesiones. NUNCA la contraseña en texto:
# generalos con `npm run admin:credentials` (pide la contraseña sin mostrarla).
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
