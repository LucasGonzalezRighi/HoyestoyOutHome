# URL pública del sitio (metadata, Open Graph y links absolutos del sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Intensidad de las animaciones: suave | equilibrado | exagerado | apagado
# Es la misma perilla "Animaciones" del diseño en Claude Design. Por defecto: exagerado.
NEXT_PUBLIC_MOTION_LEVEL=exagerado
