# URL pública del sitio (canonical, Open Graph, robots.txt y sitemap.xml), con
# protocolo: https://dominio. Vacía, cae así (src/constants/siteUrl.ts):
#   - En Vercel, a https://$VERCEL_PROJECT_PRODUCTION_URL (Vercel la define sola).
#   - Fuera de Vercel, a http://localhost:3000: alcanza para desarrollo, pero
#     en un deploy de producción fuera de Vercel es obligatoria.
# Un deploy de producción de Vercel que termine en localhost falla en el build.
NEXT_PUBLIC_APP_URL=

# Intensidad de las animaciones: suave | equilibrado | exagerado | apagado
# Es la misma perilla "Animaciones" del diseño en Claude Design. Por defecto: exagerado.
NEXT_PUBLIC_MOTION_LEVEL=exagerado
